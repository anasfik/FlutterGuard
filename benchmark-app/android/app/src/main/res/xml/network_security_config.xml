<?xml version="1.0" encoding="utf-8"?>
<!-- Intentionally permissive. Local benchmark input only; remove for any real app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Planted fact: user-installed CAs are trusted in release too. -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
