<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core capability: see every installed app. No INTERNET permission:
         FlutterGuard never transmits anything it analyzes.
         Deliberate, Play-declared use: this app is a security/inventory tool and
         the permission is granted by the user's own first-run disclosure before
         the inventory is ever read. Suppressed as a lint error on purpose; the
         Play permissions declaration is the control that applies here. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Scan execution runs in a dataSync foreground service: local, on-device
         file processing (Android service-type docs list file processing here).
         Android 14+ requires both the generic and the typed permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+: without this the scan still runs, but its progress
         notification is hidden. Requested on first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        tools:ignore="DataExtractionRules"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlutterGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- File mode without broad package visibility: an APK shared from
                 Files or another app is audited from a cache copy. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <!-- Some file managers label an APK as a plain zip. -->
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>

        <service
            android:name=".ScanService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
